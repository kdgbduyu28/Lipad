{
  "expo": {
    "name": "Lipad",
    "slug": "lipad",
    "scheme": "lipad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.lipad.app" },
    "android": {
      "package": "com.lipad.app",
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Lipad — cheap flights from the Philippines",
      "shortName": "Lipad",
      "themeColor": "#0369A1",
      "backgroundColor": "#F1F5F9"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-asset",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#0369A1" }]
    ],
    "experiments": { "typedRoutes": false },
    "description": "Find cheap flights from the Philippines and plan a trip that fits your budget."
  }
}
